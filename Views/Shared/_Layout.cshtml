<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProductDesk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProductDesk.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-light navbar-retro py-3 mb-4">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <a class="retro-brand-badge" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i> ProductDesk
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-flex align-items-center gap-4">
                        <span class="user-badge-nav">
                            <i class="bi bi-person-fill me-1"></i> @User.Identity.Name
                        </span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                            <button type="submit" class="btn-retro-nav-logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-retro text-center mt-5">
        <div class="container">
            <span>&copy; 2026 - <strong>ProductDesk</strong> • Built with ASP.NET Core MVC</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
