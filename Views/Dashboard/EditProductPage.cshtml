@using ProductDesk.Dto
@model ProductDto
@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex justify-content-center align-items-center py-4">
    <div class="card-retro p-4" style="max-width: 580px; width: 100%;">
        <div class="text-center mb-4">
            <span class="badge-retro bg-warning text-dark mb-2">EDIT MODE</span>
            <h2 class="mt-2 mb-1">Edit Product</h2>
            <p class="text-muted small fw-bold">Update details for Product #@Model?.Id</p>
        </div>

        <form asp-action="UpdateProduct">
            <input type="hidden"
                   id="id"
                   asp-for="Id"
                   required />

            <div class="mb-3">
                <label for="name" class="form-label-retro">Product Name</label>
                <input type="text"
                       class="form-control form-control-retro"
                       id="name"
                       asp-for="Name"
                       placeholder="Enter product name"
                       required />
            </div>

            <div class="mb-3">
                <label for="description" class="form-label-retro">Description</label>
                <textarea class="form-control form-control-retro"
                          id="description"
                          asp-for="Description"
                          rows="4"
                          placeholder="Enter product description"
                          required></textarea>
            </div>

            <div class="mb-4">
                <label for="cost" class="form-label-retro">Price / Cost ($)</label>
                <div class="input-group">
                    <span class="input-group-text form-control-retro bg-white border-end-0 fw-bold">$</span>
                    <input type="number"
                           class="form-control form-control-retro"
                           id="cost"
                           asp-for="Cost"
                           placeholder="0.00"
                           step="1.00"
                           min="0"
                           required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-action="Index" class="btn-retro btn-retro-outline">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>

                <button type="submit" class="btn-retro btn-retro-primary">
                    <i class="bi bi-save2-fill me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>