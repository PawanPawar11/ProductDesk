@using ProductDesk.Dto
@model ProductDto
@{
    ViewData["Title"] = "Add Product";
}

<div class="d-flex justify-content-center align-items-center py-4">
    <div class="card-retro p-4" style="max-width: 580px; width: 100%;">
        <div class="text-center mb-4">
            <span class="badge-retro bg-accent text-dark mb-2">NEW ENTRY</span>
            <h2 class="mt-2 mb-1">Add New Product</h2>
            <p class="text-muted small fw-bold">Enter product details to add to your catalog</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="alert alert-retro alert-info d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <span>@ViewBag.Message</span>
            </div>
        }

        <form asp-action="CreateProduct">
            <div class="mb-3">
                <label for="name" class="form-label-retro">Product Name</label>
                <input type="text"
                       class="form-control form-control-retro"
                       id="name"
                       name="Name"
                       asp-for="Name"
                       placeholder="e.g. Vintage Mechanical Keyboard"
                       required />
            </div>

            <div class="mb-3">
                <label for="description" class="form-label-retro">Description</label>
                <textarea class="form-control form-control-retro"
                          id="description"
                          name="Description"
                          asp-for="Description"
                          rows="4"
                          placeholder="Provide a detailed description of the product..."
                          required></textarea>
            </div>

            <div class="mb-4">
                <label for="cost" class="form-label-retro">Price / Cost ($)</label>
                <div class="input-group">
                    <span class="input-group-text form-control-retro bg-white border-end-0 fw-bold">$</span>
                    <input type="number"
                           class="form-control form-control-retro"
                           id="cost"
                           name="Cost"
                           asp-for="Cost"
                           placeholder="0.00"
                           step="0.01"
                           min="0"
                           required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-action="Index" class="btn-retro btn-retro-outline">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>

                <button type="submit" class="btn-retro btn-retro-accent">
                    <i class="bi bi-check-lg me-1"></i> Submit Product
                </button>
            </div>
        </form>
    </div>
</div>