@using ProductDesk.Dto
@model List<ProductDto>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Products</h2>

        <div>
            <a asp-action="AddProductPage" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add a Product
            </a>

            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <input type="submit" value="Logout" class="btn btn-primary" />
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Product ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Cost</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>#@product.Id</td>
                            <td>@product.Name</td>
                            <td>@product.Description</td>
                            <td>$@product.Cost</td>
                            <td class="text-center">
                                <a asp-route-id="@product.Id" asp-action="EditProductPage" class="btn btn-warning btn-sm me-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <a asp-route-id="@product.Id" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>