@using ProductDesk.Dto
@model List<ProductDto>
@{
    ViewData["Title"] = "Products Dashboard";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge-retro bg-primary text-white mb-2">DASHBOARD</span>
            <h1 class="h2 mb-0 mt-2">Product Inventory</h1>
            <p class="text-muted small fw-bold mb-0">Manage and track your products in real-time</p>
        </div>

        <div class="d-flex align-items-center gap-4 mt-5">
            <a asp-action="AddProductPage" class="btn-retro btn-retro-accent">
                <i class="bi bi-plus-circle-fill me-2"></i>Add Product
            </a>

            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn-retro btn-retro-outline">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <div class="table-retro-container">
        <div class="table-responsive">
            <table class="table table-retro align-middle">
                <thead>
                    <tr>
                        <th scope="col" style="width: 100px;">ID</th>
                        <th scope="col" style="width: 220px;">Name</th>
                        <th scope="col">Description</th>
                        <th scope="col" style="width: 140px;">Cost</th>
                        <th scope="col" class="text-center" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge-retro bg-light text-dark">#@product.Id</span>
                                </td>
                                <td class="fw-bold text-dark">@product.Name</td>
                                <td class="text-secondary">@product.Description</td>
                                <td>
                                    <span class="badge-retro bg-warning text-dark">$@product.Cost.ToString("F2")</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-4">
                                        <a asp-route-id="@product.Id" asp-action="EditProductPage" class="btn-retro btn-retro-warning btn-retro-sm">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-route-id="@product.Id" asp-action="DeleteProduct" class="btn-retro btn-retro-danger btn-retro-sm" onclick="return confirm('Are you sure you want to delete this product?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="py-4">
                                    <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                                    <h5 class="fw-bold">No Products Found</h5>
                                    <p class="text-muted small">Click "Add Product" above to create your first product entry.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>