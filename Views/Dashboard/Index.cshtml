<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Products</h2>

        <div>
            <a href="/Product/Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add a Product
            </a>

            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <input type="submit" value="Logout" class="btn btn-primary" />
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Product ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Cost</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Laptop</td>
                    <td>15.6-inch Full HD display with 16GB RAM and 512GB SSD.</td>
                    <td>$899.99</td>
                    <td class="text-center">
                        <a href="/Product/Edit/1" class="btn btn-warning btn-sm me-2">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a href="/Product/Delete/1" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Wireless Mouse</td>
                    <td>Ergonomic Bluetooth mouse with rechargeable battery.</td>
                    <td>$29.99</td>
                    <td class="text-center">
                        <a href="/Product/Edit/2" class="btn btn-warning btn-sm me-2">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a href="/Product/Delete/2" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Mechanical Keyboard</td>
                    <td>RGB backlit keyboard with blue switches.</td>
                    <td>$79.99</td>
                    <td class="text-center">
                        <a href="/Product/Edit/3" class="btn btn-warning btn-sm me-2">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>

                        <a href="/Product/Delete/3" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>