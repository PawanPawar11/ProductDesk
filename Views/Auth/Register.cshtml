@using ProductDesk.Dto
@model UserDto
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="card-retro p-4" style="max-width: 440px; width: 100%;">
        <div class="text-center mb-4">
            <span class="badge-retro bg-info text-dark mb-2">JOIN US</span>
            <h2 class="mt-2 mb-1">Create Account</h2>
            <p class="text-muted small fw-bold">Get started with ProductDesk today</p>
        </div>

        <form asp-action="RegisterUser">
            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-retro alert-info d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    <span>@ViewBag.Message</span>
                </div>
            }

            <div class="mb-3">
                <label for="username" class="form-label-retro">Username</label>
                <div class="input-group">
                    <span class="input-group-text form-control-retro bg-white border-end-0"><i class="bi bi-person-fill"></i></span>
                    <input type="text"
                           class="form-control form-control-retro"
                           id="username"
                           name="Username"
                           asp-for="Username"
                           placeholder="johndoe"
                           required />
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label-retro">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text form-control-retro bg-white border-end-0"><i class="bi bi-envelope-fill"></i></span>
                    <input type="email"
                           class="form-control form-control-retro"
                           id="email"
                           name="Email"
                           asp-for="Email"
                           placeholder="name@example.com"
                           required />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label-retro">Password</label>
                <div class="input-group">
                    <span class="input-group-text form-control-retro bg-white border-end-0"><i class="bi bi-lock-fill"></i></span>
                    <input type="password"
                           class="form-control form-control-retro"
                           id="password"
                           name="Password"
                           asp-for="Password"
                           placeholder="••••••••"
                           required />
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn-retro btn-retro-accent btn-retro-lg">
                    <i class="bi bi-person-plus-fill me-2"></i> Register Account
                </button>
            </div>

            <div class="text-center mt-4 pt-3 border-top border-2">
                <span class="fw-bold">Already have an account?</span>
                <a asp-action="Login" class="fw-extrabold text-primary text-decoration-none ms-1">Login ←</a>
            </div>
        </form>
    </div>
</div>